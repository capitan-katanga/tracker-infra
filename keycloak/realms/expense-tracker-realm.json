  "clients": [
    {
      "clientId": "api-gateway",
      "name": "API Gateway (BFF)",
      "description": "OAuth2 Client confidencial del Gateway: Authorization Code + PKCE para usuarios web (ADR-002)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${API_GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8090/"
      }
    },
    {
      "clientId": "expense-manager",
      "name": "expense-manager (M2M)",
      "description": "Client Credentials hacia transactional con scope transactions:write-on-behalf y aud = transactional (ADR-005)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EXPENSE_MANAGER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "service_account",
        "roles",
        "acr",
        "transactions:write-on-behalf"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@expense-tracker.local",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-expense-manager",
      "enabled": true,
      "serviceAccountClientId": "expense-manager"
    }
  ]
}
