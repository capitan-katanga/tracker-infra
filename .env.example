# Copiar a .env (gitignoreado). Valores solo para desarrollo local.

# Postgres (superusuario: solo init scripts y administración; los servicios NO lo usan)
POSTGRES_USER=admin
POSTGRES_PASSWORD=Password123

# Roles por servicio (ADR-009). Los usa postgres/init/02-services.sh al crear el volumen;
# cada servicio lee la misma variable para su datasource.
TRANSACTIONAL_DB_PASSWORD=transactional-dev
RECEIPT_PARSER_DB_PASSWORD=receipt-parser-dev

# Keycloak
KEYCLOAK_DB_PASSWORD=keycloak-dev
KEYCLOAK_ADMIN_PASSWORD=admin-dev
API_GATEWAY_CLIENT_SECRET=api-gateway-dev-secret
EXPENSE_MANAGER_CLIENT_SECRET=expense-manager-dev-secret
KEYCLOAK_DEMO_USER_PASSWORD=demo
